# Copy to .env.local and fill in. Restart the dev server after changes.

# --- Stocks: Alpaca (https://alpaca.markets) ---
# Free "Market Data" keys work. Without these the Stocks page still runs but
# fetching prices and adding symbols will show a "keys not set" message.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Weather + location search: OpenWeather (https://openweathermap.org/api) ---
# Powers the forecast (One Call 4.0 timeline + One Call 3.0 day_summary) and
# city search. Both One Call endpoints need an active paid subscription on the
# key ("One Call by Call" — 1000 calls/day included). Without a key the Weather
# page loads but fetch and search show a "key not set" message.
OPENWEATHER_API_KEY=

# --- Custom checks: AI-assisted selector suggestion (https://console.anthropic.com) ---
# Powers the "Suggest selector" button on the Custom checks page. Without a
# key, custom checks still work — the user just has to supply a CSS selector
# themselves (devtools) instead of describing the value in plain language.
ANTHROPIC_API_KEY=

ODDS_API_KEY=
