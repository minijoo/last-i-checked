# Copy to .env.local and fill in. Restart the dev server after changes.

# --- Stocks: Alpaca (https://alpaca.markets) ---
# Free "Market Data" keys work. Without these the Stocks page still runs but
# fetching prices and adding symbols will show a "keys not set" message.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Weather: NWS (no key) ---
# NWS asks for an identifying User-Agent with contact info.
NWS_USER_AGENT=last-i-checked/0.1 (you@example.com)

# --- Location search: GeoNames (https://www.geonames.org/login) ---
# Optional. If unset, location search falls back to Open-Meteo's keyless API.
GEONAMES_USERNAME=
