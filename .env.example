# Copy to .env.local and fill in. Restart the dev server after changes.

# --- Stocks: Alpaca (https://alpaca.markets) ---
# Free "Market Data" keys work. Without these the Stocks page still runs but
# fetching prices and adding symbols will show a "keys not set" message.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Weather + location search: OpenWeather (https://openweathermap.org/api) ---
# Powers the forecast (16-day daily + One Call 3.0 day_summary) and city search.
# The 16-day and One Call 3.0 endpoints need an active paid subscription on the
# key ("One Call by Call" — 1000 calls/day included). Without a key the Weather
# page loads but fetch and search show a "key not set" message.
OPENWEATHER_API_KEY=
